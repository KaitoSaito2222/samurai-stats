# Local development environment variables
# Copy this file to .env.local and fill in the values.
# docker compose automatically loads .env.local.
#
# The defaults below work out-of-the-box for local Docker dev.
# Only GEMINI_API_KEY and ANTHROPIC_API_KEY need real values for AI features.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=localpassword

# ── Supabase local JWT (matches docker/nginx.conf routing) ───────────────
# These are Supabase's standard local dev keys — safe to use locally.
# NEVER use these in production.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqd6m0F3MhQdCCPAZdX4gIhJoMBXKGnfk
SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ── AI APIs (required for AI features) ───────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Stripe (dummy values work for local — use test keys for Stripe testing) ─
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy

# ── Internal ──────────────────────────────────────────────────────────────
INTERNAL_API_KEY=local-internal-key
