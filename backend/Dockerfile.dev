FROM python:3.11-slim

WORKDIR /app

# Install dependencies first (layer cache — only rebuilds when requirements.txt changes)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Source is mounted as a volume at runtime — no COPY needed here.
# uvicorn --reload watches for file changes via the volume mount.

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
